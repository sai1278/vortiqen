# ---------------------------------------------------------------------------
# Vortiqen API — example configuration. No real secrets belong in this file.
# Copy to .env and fill in per environment:  cp .env.example .env
# ---------------------------------------------------------------------------

APP_NAME="Vortiqen API"

# development | staging | production
# Defaults to "production" in code so an unconfigured deployment fails loudly
# rather than accepting enquiries it cannot deliver. Set explicitly for local work.
ENVIRONMENT="development"

# ---------------------------------------------------------------------------
# CORS — exact origins only, comma-separated. "*" is rejected at startup.
# Credentials are disabled in code; the website sends plain JSON, no cookies.
#   local:      http://localhost:3000
#   production: https://vortiqen.com,https://www.vortiqen.com
# Plaintext http:// origins (other than localhost) are refused in production.
# ---------------------------------------------------------------------------
ALLOWED_ORIGINS="http://localhost:3000"

# ---------------------------------------------------------------------------
# Persistence — Relational Database (PostgreSQL in production) & JSONL fallback
# ---------------------------------------------------------------------------
#   production: postgresql+asyncpg://user:password@host:5432/vortiqen
#   local/dev:  optional, falls back to ENQUIRY_STORE_PATH if omitted
DATABASE_URL=""

# Append-only JSONL record of every enquiry.
ENQUIRY_STORE_PATH="data/enquiries.jsonl"

# In production the local file is NOT counted as delivery unless you opt in
# here. Set true ONLY if you explicitly intend to rely on local disk without a DB.
ALLOW_LOCAL_PERSISTENCE_IN_PRODUCTION="false"

# ---------------------------------------------------------------------------
# Outbound channels. Configure at least one for production.
# ---------------------------------------------------------------------------
# Slack / Discord / Zapier / custom webhook endpoint
NOTIFICATION_WEBHOOK_URL=""
NOTIFICATION_WEBHOOK_TIMEOUT_SECONDS="8"

# Baserow Table API integration (server-side lead sync)
BASEROW_TABLE_URL=""
BASEROW_API_TOKEN=""
BASEROW_TIMEOUT_SECONDS="8"

# SMTP requires SMTP_HOST + SENDER_EMAIL + TEAM_INBOX to be considered configured.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_STARTTLS="true"
SENDER_EMAIL=""
TEAM_INBOX=""

# ---------------------------------------------------------------------------
# Rate limiting (per client key, sliding window, in-process).
# ---------------------------------------------------------------------------
RATE_LIMIT_WINDOW_SECONDS="600"
RATE_LIMIT_MAX_REQUESTS="5"

# Number of reverse proxies in front of this app.
#   0 = ignore X-Forwarded-For entirely and use the socket peer (default, safe)
#   1 = one trusted proxy (nginx / ALB / Cloudflare); the client is the last
#       entry in X-Forwarded-For. Only raise this if the proxy APPENDS to the
#       header rather than replacing it — otherwise the value can be forged.
TRUSTED_PROXY_COUNT="0"
